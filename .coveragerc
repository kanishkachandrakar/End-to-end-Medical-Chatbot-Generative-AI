[run]
source = src

# Nothing is omitted: load_pdf is covered against generated PDFs, and the one
# function that needs torch (download_hugging_face_embeddings) is excluded by
# the report rule below rather than the whole module.

[report]
show_missing = True
exclude_also =
    if TYPE_CHECKING:
    ^\s*\.\.\.$
    # Constructing HuggingFaceEmbeddings loads torch and downloads weights;
    # CI installs neither, by design.
    def download_hugging_face_embeddings
