# Copy to .env and fill in your own keys. .env is gitignored.
# On Hugging Face Spaces set these two as *secrets* instead -- see DEPLOY.md.
PINECONE_API_KEY=
GROQ_API_KEY=

# Optional: set to 1 to enable the Flask reloader/debugger (local only)
FLASK_DEBUG=

# -----------------------------------------------------------------------------
# Everything below is optional. The values shown are the defaults from
# src/config.py; uncomment a line only to override it.
# -----------------------------------------------------------------------------

# Pinecone index. Changing the name points the app at a different index; the
# cloud and region only apply when store_index.py has to create it.
# PINECONE_INDEX=medicalbot
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Embeddings. EMBED_DIM must match the model's output size, and both must match
# the index -- an existing index cannot be reused with a different model.
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBED_DIM=384

# Chunking, applied by store_index.py. Changing these means reindexing.
# CHUNK_SIZE=500
# CHUNK_OVERLAP=20

# Retrieval and generation.
# TOP_K=3
# GROQ_MODEL=deepseek-r1-distill-qwen-32b
# Seconds to wait for a Groq response before giving up.
# GROQ_TIMEOUT=60.0

# Longest question accepted by POST /get.
# MAX_QUESTION_CHARS=500

# Hard ceiling on a request body, refused by Flask before it is parsed.
# MAX_CONTENT_BYTES=65536

# Questions answered per minute across the whole app; 0 disables the limit.
# RATE_LIMIT_PER_MINUTE=30

# Port for 'python app.py'. The container reads $PORT too, defaulting to 7860.
# PORT=8080

# Verbosity of the application log.
# LOG_LEVEL=INFO
