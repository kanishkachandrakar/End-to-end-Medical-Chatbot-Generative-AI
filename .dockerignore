.git
.gitignore
.env
.DS_Store

# 15MB source PDF, only needed by store_index.py, which is run locally
Data/

# Prototyping notebook and its checkpoints
research/
.ipynb_checkpoints/

__pycache__/
*.py[cod]
*.egg-info/

# A local virtualenv is gigabytes of wheels for the host's platform. Left in
# the build context it is uploaded to the daemon on every build and, worse,
# COPY . . would put it in the image.
.venv/
venv/
env/
.tox/

# README.md carries the Space's configuration frontmatter, so the Space repo
# needs it -- but the running container has no use for any of this.
README.md
DEPLOY.md
CHANGELOG.md
SECURITY.md
CONTRIBUTING.md
LICENSE

# Editor and hook configuration: of no use inside a container, and both
# change on commits that touch nothing the container runs.
.editorconfig
.pre-commit-config.yaml

# Development-only: the suite, the dev requirements, the deploy script and the
# workflows are not part of the runtime image.
#
# pyproject.toml is not listed. It holds the ruff, pytest, coverage and mypy
# settings, so the tooling config does travel into the image -- there is no
# separating it from the package metadata that shares the file. Nothing in the
# build reads it: setup.py is what satisfies the `-e .` at the end of
# requirements.txt, and that layer runs before `COPY . .`. It stays unexcluded
# because the deploy script ships it too, and the image CI builds should not
# differ from the image a Space builds.
tests/
requirements-dev.txt
scripts/
.github/
